# ===== Web =====
# 浏览器访问端口（只暴露 Web，其余服务走内部网络）
EDUDOC_WEB_PORT=8088

# ===== Oracle（首次启动使用，之后改密码需重建数据卷）=====
# 仅字母+数字，避免 SQL*Plus 连接串转义问题
EDUDOC_ORACLE_PWD=EdudocOracle2026
EDUDOC_DB_USERNAME=user_cidas
EDUDOC_DB_PASSWORD=cidas123

# ===== 认证 / 服务间 =====
# start 脚本会自动补全空值；也可手动填写 64 位随机串
EDUDOC_JWT_SECRET=
EDUDOC_AI_INTERNAL_TOKEN=

# ===== AI 模型（硅基流动）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EDUDOC_LLM_MODEL=deepseek-ai/DeepSeek-V3
EDUDOC_ANSWER_MODEL=Qwen/Qwen2.5-7B-Instruct
EDUDOC_EMBEDDING_MODEL=BAAI/bge-m3
EDUDOC_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 阿里云 OSS（上传文档 / 作业附件 / 文档图片必需）=====
EDUDOC_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
EDUDOC_OSS_REGION=cn-beijing
EDUDOC_OSS_BUCKET=cidas-oss-bucket
EDUDOC_OSS_ACCESS_KEY_ID=
EDUDOC_OSS_ACCESS_KEY_SECRET=
# 浏览器直传 STS 角色；不同 RAM 账号请替换
EDUDOC_OSS_ROLE_ARN=acs:ram::1389486492585567:role/edudoc-upload
EDUDOC_OSS_STS_ENDPOINT=sts.cn-beijing.aliyuncs.com

# ===== 可选：AI 服务是否安装 LibreOffice（PDF/DOCX 转换）=====
EDUDOC_INSTALL_CONVERT=true